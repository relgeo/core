{
  "name": "@relgeo/core",
  "version": "0.5.0",
  "description": "Relation-first parametric geometry engine",
  "homepage": "https://relgeo.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/relgeo/core.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsc --noEmit && tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "geometry",
    "parametric",
    "cad",
    "relation-first",
    "svg"
  ],
  "author": {
    "name": "Agus Made",
    "email": "krisnaparta@gmail.com",
    "url": "https://github.com/agusmade"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "@relgeo/geometry": "^0.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@relgeo/renderer-svg": "^0.5.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
